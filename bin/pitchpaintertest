#!/bin/bash
#
# pitchpaintertest


# Stop on errors, print commands
# See https://vaneyckt.io/posts/safer_bash_scripts_with_set_euxo_pipefail/
set -Eeuo pipefail
set -x

pip install pycodestyle pydocstyle pylint pytest --quiet

# Run pycodestyle
pycodestyle src/pitchpainter tests/pitch_painter --max-line-length=120

# Run pydocstyle
pydocstyle src/pitchpainter tests/pitch_painter

# Run pylint
pylint src/pitchpainter tests/pitch_painter --max-line-length=120 --disable=fixme,duplicate-code

# Run all unit tests
pytest -v tests/pitch_painter
