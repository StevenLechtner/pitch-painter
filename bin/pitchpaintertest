#!/bin/bash
#
# pitchpaintertest


# Stop on errors, print commands
# See https://vaneyckt.io/posts/safer_bash_scripts_with_set_euxo_pipefail/
set -Eeuo pipefail
set -x

pip install pycodestyle pydocstyle pylint pytest --quiet

# Run pycodestyle
pycodestyle src/pitchpainter --max-line-length=120

# Run pydocstyle
pydocstyle src/pitchpainter

# Run pylint
pylint src/pitchpainter

# Run all unit tests
pytest -v tests/pitch_painter
